// GEGENEREERD door ModelArchDSL — niet met de hand bewerken.
// Bron: archmodel/tobe.archdsl (ontwerp) + archmodel/asis.facts.json (code).
set language archimate
set title "PDFHorse — Fysiek"
set subtitle "Architectuurplaat fysiek niveau (ArchiMate/Dragon1)"
set purpose "PDF's samenvoegen, splitsen, invullen, ondertekenen, converteren, OCR'en en mailen zonder account en zonder permanente opslag; zoveel mogelijk in de browser."
show legend true
switch badges on
set current state "As-is (code)"
set target state "To-be (ontwerp)"

Group laag_application "Applicatie" {
    -width 420
    -height 180
}
ApplicationInterface auto_api_api_anchor "Routes /api/anchor/* (1)" in laag_application {
    -fill "#f5f3ff"
    -stroke "#7c3aed"
    -state current
    -attr status = "alleen_code"
    -attr feiten = "1"
}
Artifact auto_config "Configuratie (omgeving) (5)" in laag_application {
    -fill "#f5f3ff"
    -stroke "#7c3aed"
    -state current
    -attr status = "alleen_code"
    -attr feiten = "5"
}

Group laag_technology "Technologie" {
    -width 1220
    -height 310
}
Node nd_hc55 "HC55 157.180.29.184 (Hetzner, EU)" in laag_technology {
    -fill "#f0f9ff"
    -stroke "#0284c7"
    -attr status = "extern"
}
Node nd_hostinger "Hostinger (smtp.hostinger.com)" in laag_technology {
    -fill "#f0f9ff"
    -stroke "#0284c7"
    -attr status = "extern"
}
Node nd_icthorse "icthorse.nl/PDFHorse/ (reverse-proxy via Hostinger)" in laag_technology {
    -fill "#fff7ed"
    -stroke "#ea580c"
    -state target
    -attr status = "gepland"
    -description "README: gepland; nu LIVE op horsecloud55.ddns.net/PDFHorse/."
}
SystemSoftware ss_uvicorn "uvicorn :3963 (pdfhorse.service, 2 workers)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "unit:pdfhorse.service, dep:pip:uvicorn, dep:pip:fastapi, dep:pip:python-multipart, config:APP_HOST, config:APP_PORT"
}
SystemSoftware ss_soffice "LibreOffice headless (soffice)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "config:SOFFICE_*"
}
SystemSoftware ss_ocrmypdf "ocrmypdf 16.5.0 + Tesseract nld+eng" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "dep:pip:ocrmypdf, dep:pip:pikepdf, config:OCRMYPDF_BIN, config:OCR_*"
    -description "pikepdf<9 vastgepind omdat ocrmypdf 16.5.0 de oude Pdf.check-API verwacht."
}
SystemSoftware ss_slowapi "slowapi (geïnstalleerd, niet gebruikt op /api/mail)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "dep:pip:slowapi"
}
SystemSoftware ss_test "Testgereedschap (pytest + httpx)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "dep:pip:pytest, dep:pip:httpx"
}
SystemSoftware ss_cleanup "Opruimjob /tmp/pdfhorse (ouder dan 30 min)" in laag_technology {
    -fill "#fff7ed"
    -stroke "#ea580c"
    -state target
    -attr status = "gepland"
    -description "ARCHITECTURE Limieten + ACTIONS open; deploy/cleanup.cron staat nog op TBD."
}
TechnologyInterface ti_nginx_static "nginx /PDFHorse/ statisch (/var/www/pdfhorse/frontend)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "nginx:/PDFHorse/, nginx:/PDFHorse, nginx:*html$, nginx:*webp)$"
}
TechnologyInterface ti_nginx_api "nginx /PDFHorse/api/ naar :3963 (access_log off)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "nginx:/PDFHorse/api/"
}
TechnologyService ts_smtp "Hostinger SMTP :587 STARTTLS (login info@icthorse.nl)" in laag_technology {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "config:SMTP_*"
}

// Posities (deterministische raster-layout per ArchiMate-laag)
pos laag_application 40, 40
pos auto_api_api_anchor 60, 90
pos auto_config 260, 90
pos laag_technology 40, 260
pos nd_hc55 60, 310
pos nd_hostinger 260, 310
pos nd_icthorse 460, 310
pos ss_uvicorn 660, 310
pos ss_soffice 860, 310
pos ss_ocrmypdf 1060, 310
pos ss_slowapi 60, 440
pos ss_test 260, 440
pos ss_cleanup 460, 440
pos ti_nginx_static 660, 440
pos ti_nginx_api 860, 440
pos ts_smtp 1060, 440

// Relaties — Dragon1-compatibel: werkwoordvorm, of ongetypeerd waar Dragon1 het type afleidt
ts_smtp associates nd_hostinger "draait op"
nd_hc55 -> ss_uvicorn "host"
nd_hc55 -> ss_soffice "host"
nd_hc55 -> ss_ocrmypdf "host"
nd_hc55 -> ti_nginx_static "host"
nd_hc55 -> ss_cleanup "host"
ss_slowapi associates ss_uvicorn "geïnstalleerd, ongebruikt"
ti_nginx_api serves ss_uvicorn "proxy"
ti_nginx_static composes ti_nginx_api
nd_icthorse serves ti_nginx_static "to-be"

// GEGENEREERD door ModelArchDSL — niet met de hand bewerken.
// Bron: archmodel/tobe.archdsl (ontwerp) + archmodel/asis.facts.json (code).
set language archimate
set title "PDFHorse — Klantreis: PDF's en .docx samenvoegen"
set subtitle "Klantreis (stappen genummerd, afspeelbaar in het portaal)"
set purpose "PDF's blijven in de browser; alleen .docx gaat kort naar de server voor conversie."
show legend true
switch badges on
set current state "As-is (code)"
set target state "To-be (ontwerp)"

Group laag_business "Business" {
    -width 1220
    -height 310
}
BusinessActor ba_gebruiker "Anonieme gebruiker" in laag_business {
    -attr status = "ontwerp"
}
BusinessProcess bp_bestanden_kiezen "PDF's en .docx kiezen" in laag_business {
    -step 1
    -attr status = "ontwerp"
}
BusinessProcess bp_volgorde "Volgorde bepalen" in laag_business {
    -step 2
    -attr status = "ontwerp"
}
BusinessProcess bp_mergen "Samenvoegen tot één PDF" in laag_business {
    -step 3
    -attr status = "ontwerp"
}
BusinessProcess bp_downloaden "Downloaden of printen" in laag_business {
    -step 4
    -attr status = "ontwerp"
}
BusinessService bs_bewerken "PDF bewerken in de browser" in laag_business {
    -attr status = "ontwerp"
}
BusinessService bs_uitvoer "Resultaat downloaden, printen of mailen" in laag_business {
    -attr status = "ontwerp"
}

Group laag_application "Applicatie" {
    -width 620
    -height 180
}
ApplicationComponent ac_bewerker "PDF-bewerker: merge, split, invullen, ondertekenen" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:frontend/js"
    -description "app.js met pdf-lib 1.17.1, PDF.js 4.0.379 en signature_pad 5.0.4. AUTO-veldherkenning ook op platte PDF's (v0.18.0)."
}
ApplicationInterface ai_convert "Conversie-API docx/xlsx/odt/rtf naar PDF" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "route:POST /api/convert/*, config:MAX_DOCX_BYTES, config:MAX_XLSX_BYTES, config:MAX_ODT_BYTES, config:MAX_RTF_BYTES"
}
ApplicationComponent ac_outputbar "Output-bar: Download, Print, Mail" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:frontend/js"
}

// Posities (deterministische raster-layout per ArchiMate-laag)
pos laag_business 40, 40
pos ba_gebruiker 60, 90
pos bp_bestanden_kiezen 260, 90
pos bp_volgorde 460, 90
pos bp_mergen 660, 90
pos bp_downloaden 860, 90
pos bs_bewerken 1060, 90
pos bs_uitvoer 60, 220
pos laag_application 40, 390
pos ac_bewerker 60, 440
pos ai_convert 260, 440
pos ac_outputbar 460, 440

// Relaties — Dragon1-compatibel: werkwoordvorm, of ongetypeerd waar Dragon1 het type afleidt
ba_gebruiker -> bp_bestanden_kiezen
bp_mergen realizes bs_bewerken
bp_downloaden realizes bs_uitvoer
ac_bewerker serves bp_bestanden_kiezen
ac_bewerker serves bp_volgorde
ac_bewerker serves bp_mergen
ai_convert serves bp_mergen "docx in merge"
ac_outputbar serves bp_downloaden
bp_bestanden_kiezen -> bp_volgorde
bp_volgorde -> bp_mergen
bp_mergen -> bp_downloaden

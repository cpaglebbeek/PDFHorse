// PDFHorse — architectuurontwerp (to-be) in ArchDSL.
// Bron van het ONTWERP. Platen in generated/ komen hieruit plus de gemeten code
// (asis.facts.json) via /ModelArchDSL update. Niet de platen bewerken, wel dit bestand.
// Inhoud overgenomen uit README.md, ARCHITECTURE.md, CLAUDE.md, ACTIONS.md, CHANGELOG.md,
// docs/PRINCIPLES.md, docs/DEPENDENCIES.md, docs/PRIVACY.md, deploy/ en version.json (v0.21.0-Bienz).
//
// Conventies: ArchPortal/docs/DSL_CONVENTIES.md
//   -view conceptueel|logisch|fysiek · -attr trace = "<glob op feit-id>" · -attr status = "gepland"|"extern"

set title "PDFHorse"
set subtitle "Anonieme browser-first PDF-bewerker (iCt Horse tooling SaaS)"
set purpose "PDF's samenvoegen, splitsen, invullen, ondertekenen, converteren, OCR'en en mailen zonder account en zonder permanente opslag; zoveel mogelijk in de browser."

// ================= Conceptueel =================
Driver dr_privacy "PDF's bevatten gevoelige inhoud (contracten, medisch, financieel)"
Driver dr_alternatief "Anoniem alternatief voor Adobe, Smallpdf en iLovePDF"
Goal go_anoniem "PDF bewerken zonder account, tracking of opslag"
Goal go_minimaal "Inhoud verlaat het apparaat alleen waar onvermijdelijk"
Principle pr_client "P1 Client-first"
Principle pr_cdn "P2 CDN-only, geen build-pipeline"
Principle pr_stateless "P3 Stateless server, geen database"
Principle pr_anoniem "P4 Geen account, geen tracking"
Principle pr_mailonly "P5 Mail alleen naar opgegeven adres, geen archief"
Principle pr_agpl "P6 AGPL-3.0 copyleft"
Principle pr_limieten "P7 Limieten als deel van het ontwerp"
Principle pr_docs "P8 Documentatie is onderdeel van de feature"
Requirement rq_wissen "Server-uploads direct gewist (BackgroundTask rmtree)"
Requirement rq_ratelimit "Mail: max 5 MB bijlage, 5 per uur per IP"
Constraint cn_limieten "50 MB per PDF, 20 MB per office-bestand, 100 MB per sessie"
Constraint cn_from "Afzender moet gelijk zijn aan SMTP-login (Hostinger weigert anders)"
BusinessActor ba_gebruiker "Anonieme gebruiker"
BusinessActor ba_ontvanger "Ontvanger van de gemailde PDF"
BusinessService bs_bewerken "PDF bewerken in de browser"
BusinessService bs_converteren "Documenten en afbeeldingen naar PDF"
BusinessService bs_ocr "Gescande PDF doorzoekbaar maken (NL+EN)"
BusinessService bs_uitvoer "Resultaat downloaden, printen of mailen"
BusinessService bs_watermerk "Onzichtbaar watermerk zetten en lezen"
BusinessService bs_payload "Bestand (versleuteld) in een PDF inbedden"
BusinessService bs_delen "Delen en meekijken" {
    -attr status = "extern"
}

// Stappen van de klantreizen
BusinessProcess bp_bestanden_kiezen "PDF's en .docx kiezen"
BusinessProcess bp_volgorde "Volgorde bepalen"
BusinessProcess bp_mergen "Samenvoegen tot één PDF"
BusinessProcess bp_pdf_kiezen "PDF kiezen"
BusinessProcess bp_invullen "Velden invullen (AUTO of klik)"
BusinessProcess bp_ondertekenen "Handtekening plaatsen (bitmap, SVG of live)"
BusinessProcess bp_downloaden "Downloaden of printen"
BusinessProcess bp_office_kiezen "Office-document of afbeelding kiezen"
BusinessProcess bp_converteren "Naar PDF converteren"
BusinessProcess bp_mailen "PDF mailen naar ontvanger"
BusinessProcess bp_scan_kiezen "Gescande PDF uploaden"
BusinessProcess bp_ocr "OCR uitvoeren"
BusinessProcess bp_sleutels "Sleutelpaar maken en downloaden (JWK)"
BusinessProcess bp_inbedden "Bestand versleuteld inbedden"
BusinessProcess bp_uitlezen "Payload uitlezen en ontsleutelen"
BusinessProcess bp_watermerk_zetten "Watermerk zetten (tekst, SVG/PNG of document)"
BusinessProcess bp_watermerk_lezen "Watermerk teruglezen"
BusinessProcess bp_splitsen "Splitsen op paginabereiken"

// ================= Logisch =================
ApplicationComponent ac_frontend "PDFHorse-frontend (Alpine.js, één index.html)" {
    -attr trace = "module:frontend/js"
    -description "Negen tabs; CDN-only zonder build (P2). Merge/split/invullen/ondertekenen/watermerk/payload volledig in de browser (P1)."
}
ApplicationComponent ac_bewerker "PDF-bewerker: merge, split, invullen, ondertekenen" {
    -attr trace = "module:frontend/js"
    -description "app.js met pdf-lib 1.17.1, PDF.js 4.0.379 en signature_pad 5.0.4. AUTO-veldherkenning ook op platte PDF's (v0.18.0)."
}
ApplicationComponent ac_outputbar "Output-bar: Download, Print, Mail" {
    -attr trace = "module:frontend/js"
}
ApplicationComponent ac_watermark "Watermerk-engine (watermark.js)" {
    -attr trace = "module:frontend/js"
    -description "Tekst- en beeld-watermerk in achtergrondkleur, payload in PDF-metadata; document-modus via de payload-engine (v0.21.0)."
}
ApplicationComponent ac_payload "Payload-engine (payload.js, AES-GCM + RSA-OAEP)" {
    -attr trace = "module:frontend/js"
    -description "Embedded-file bijlage pdfhorse-payload.json; hybride versleuteling via WebCrypto."
}
ApplicationComponent ac_i18n "Taallaag NL/EN (i18n.js + i18n.json)" {
    -attr trace = "module:frontend/js"
}
ApplicationComponent ac_backend "PDFHorse-backend (FastAPI, stateless)" {
    -attr trace = "module:backend, config:ALLOWED_ORIGIN, config:PDFHORSE_DEV"
    -description "Alleen voor wat niet in de browser kan: office-conversie, OCR en mail (P1, P3). CORS strikt op ALLOWED_ORIGIN."
}
ApplicationInterface ai_info "Health- en limieten-API" {
    -attr trace = "route:GET /api/health, route:GET /api/limits"
}
ApplicationInterface ai_convert "Conversie-API docx/xlsx/odt/rtf naar PDF" {
    -attr trace = "route:POST /api/convert/*, config:MAX_DOCX_BYTES, config:MAX_XLSX_BYTES, config:MAX_ODT_BYTES, config:MAX_RTF_BYTES"
}
ApplicationInterface ai_ocr "OCR-API" {
    -attr trace = "route:POST /api/ocr, config:MAX_OCR_BYTES"
}
ApplicationInterface ai_mail "Mail-API" {
    -attr trace = "route:POST /api/mail, config:MAIL_FROM, config:MAIL_REPLY_TO, config:MAX_MAIL_*"
}
ApplicationComponent ac_ratelimit "Rate-limit in-process bucket per IP" {
    -attr trace = "config:MAIL_RATE_*"
    -description "Vervangt slowapi-decorator wegens ForwardRef-conflict (Python 3.14 + FastAPI + Annotated)."
}
ApplicationComponent ac_scripts "Hulpscripts: schermafdrukken en live-verificatie (Playwright)" {
    -attr trace = "module:scripts"
}
DataObject do_pdf "PDF en bewerkingsstaat (alleen in browsergeheugen)" {
    -attr trace = "module:frontend/js"
}
DataObject do_payload "Payload-envelope pdfhorse-payload.json" {
    -attr trace = "module:frontend/js"
}
DataObject do_sleutel "Sleutelpaar als JWK (alleen bij de gebruiker)" {
    -attr trace = "module:frontend/js"
}
DataObject do_tmp "Tijdelijke upload /tmp/pdfhorse/<uuid>" {
    -attr trace = "config:TMP_DIR, config:SESSION_TIMEOUT_S"
}
ApplicationComponent ac_cdn "CDN-bibliotheken (Tailwind, Alpine, pdf-lib, PDF.js, signature_pad, ImageTracer)" {
    -attr status = "extern"
}
ApplicationComponent ac_clipboard "iCt Horse clipboard-artefact (icthorse.nl/clipboard)" {
    -attr status = "extern"
}
ApplicationComponent ac_donate "iCt Horse donate-artefact (bunq.me-link + QR)" {
    -attr status = "extern"
}
ApplicationComponent ac_pades "PAdES digitale handtekening (X.509)" {
    -attr status = "gepland"
    -description "ACTIONS 'Later (v1.0.0-Brotz)': apart traject, niet MVP."
}
ApplicationComponent ac_pwa "PWA / offline-modus (Service Worker)" {
    -attr status = "gepland"
    -description "ACTIONS 'Later (v1.0.0-Brotz)'."
}

// ================= Fysiek =================
Node nd_hc55 "HC55 157.180.29.184 (Hetzner, EU)" {
    -attr status = "extern"
}
Node nd_hostinger "Hostinger (smtp.hostinger.com)" {
    -attr status = "extern"
}
Node nd_icthorse "icthorse.nl/PDFHorse/ (reverse-proxy via Hostinger)" {
    -attr status = "gepland"
    -description "README: gepland; nu LIVE op horsecloud55.ddns.net/PDFHorse/."
}
SystemSoftware ss_uvicorn "uvicorn :3963 (pdfhorse.service, 2 workers)" {
    -attr trace = "unit:pdfhorse.service, dep:pip:uvicorn, dep:pip:fastapi, dep:pip:python-multipart, config:APP_HOST, config:APP_PORT"
}
SystemSoftware ss_soffice "LibreOffice headless (soffice)" {
    -attr trace = "config:SOFFICE_*"
}
SystemSoftware ss_ocrmypdf "ocrmypdf 16.5.0 + Tesseract nld+eng" {
    -attr trace = "dep:pip:ocrmypdf, dep:pip:pikepdf, config:OCRMYPDF_BIN, config:OCR_*"
    -description "pikepdf<9 vastgepind omdat ocrmypdf 16.5.0 de oude Pdf.check-API verwacht."
}
SystemSoftware ss_slowapi "slowapi (geïnstalleerd, niet gebruikt op /api/mail)" {
    -attr trace = "dep:pip:slowapi"
}
SystemSoftware ss_test "Testgereedschap (pytest + httpx)" {
    -attr trace = "dep:pip:pytest, dep:pip:httpx"
}
SystemSoftware ss_cleanup "Opruimjob /tmp/pdfhorse (ouder dan 30 min)" {
    -attr status = "gepland"
    -description "ARCHITECTURE Limieten + ACTIONS open; deploy/cleanup.cron staat nog op TBD."
}
TechnologyInterface ti_nginx_static "nginx /PDFHorse/ statisch (/var/www/pdfhorse/frontend)" {
    -attr trace = "nginx:/PDFHorse/, nginx:/PDFHorse, nginx:*html$, nginx:*webp)$"
}
TechnologyInterface ti_nginx_api "nginx /PDFHorse/api/ naar :3963 (access_log off)" {
    -attr trace = "nginx:/PDFHorse/api/"
}
TechnologyService ts_smtp "Hostinger SMTP :587 STARTTLS (login info@icthorse.nl)" {
    -attr trace = "config:SMTP_*"
}
Artifact ar_env "Instellingen /opt/pdfhorse/.env (mode 600)" {
    -attr trace = "config:MAX_UPLOAD_SIZE_BYTES, config:MAX_SESSION_TOTAL_BYTES"
}

// ================= Relaties =================
dr_privacy -> go_minimaal : influence "drijft aan"
dr_alternatief -> go_anoniem : influence "drijft aan"
go_minimaal -> pr_client : influence "leidt tot"
go_anoniem -> pr_anoniem : influence "leidt tot"
pr_client -> pr_stateless : influence "vereist"
pr_anoniem -> pr_mailonly : influence "vereist"
pr_stateless -> rq_wissen : influence "vereist"
pr_limieten -> cn_limieten : influence "legt vast"
pr_limieten -> rq_ratelimit : influence "legt vast"
pr_agpl -> go_anoniem : influence "maakt controleerbaar"
pr_docs -> go_anoniem : influence "borgt"
pr_cdn -> ac_frontend : influence "begrenst"
cn_from -> ts_smtp : influence "begrenst"
rq_wissen -> do_tmp : influence "begrenst"
rq_ratelimit -> ac_ratelimit : realization

ba_gebruiker -> bp_pdf_kiezen : assignment
ba_gebruiker -> bp_bestanden_kiezen : assignment
ba_gebruiker -> bp_office_kiezen : assignment
ba_gebruiker -> bp_scan_kiezen : assignment
ba_gebruiker -> bp_sleutels : assignment
bp_mailen -> ba_ontvanger : flow "mail met PDF-bijlage"
bp_mergen -> bs_bewerken : realization
bp_splitsen -> bs_bewerken : realization
bp_invullen -> bs_bewerken : realization
bp_ondertekenen -> bs_bewerken : realization
bp_converteren -> bs_converteren : realization
bp_ocr -> bs_ocr : realization
bp_downloaden -> bs_uitvoer : realization
bp_mailen -> bs_uitvoer : realization
bp_watermerk_zetten -> bs_watermerk : realization
bp_watermerk_lezen -> bs_watermerk : realization
bp_inbedden -> bs_payload : realization
bp_uitlezen -> bs_payload : realization
ac_clipboard -> bs_delen : realization

ac_bewerker -> bp_bestanden_kiezen : serving
ac_bewerker -> bp_volgorde : serving
ac_bewerker -> bp_mergen : serving
ai_convert -> bp_mergen : serving "docx in merge"
ac_bewerker -> bp_splitsen : serving
ac_bewerker -> bp_pdf_kiezen : serving
ac_bewerker -> bp_invullen : serving
ac_bewerker -> bp_ondertekenen : serving
ac_outputbar -> bp_downloaden : serving
ac_frontend -> bp_office_kiezen : serving
ai_convert -> bp_converteren : serving "office"
ac_bewerker -> bp_converteren : serving "png/jpg in de browser"
ac_outputbar -> bp_mailen : serving
ai_mail -> bp_mailen : serving
ac_frontend -> bp_scan_kiezen : serving
ai_ocr -> bp_ocr : serving
ac_payload -> bp_sleutels : serving
ac_payload -> bp_inbedden : serving
ac_payload -> bp_uitlezen : serving
ac_watermark -> bp_watermerk_zetten : serving
ac_watermark -> bp_watermerk_lezen : serving
ac_pades -> bp_ondertekenen : serving "to-be"

ac_frontend -> ac_bewerker : composition
ac_frontend -> ac_outputbar : composition
ac_frontend -> ac_watermark : composition
ac_frontend -> ac_payload : composition
ac_frontend -> ac_i18n : composition
ac_frontend -> ac_pwa : composition "to-be"
ac_watermark -> ac_payload : serving "document-modus"
ac_cdn -> ac_frontend : serving "bibliotheken"
ac_clipboard -> ac_frontend : serving "tab Delen & meekijken"
ac_donate -> ac_outputbar : serving "donatie-teaser"
ac_frontend -> ai_info : serving "leest"
ac_outputbar -> ai_mail : serving "POST"
ac_frontend -> ai_convert : serving "POST"
ac_frontend -> ai_ocr : serving "POST"
ac_backend -> ai_info : composition
ac_backend -> ai_convert : composition
ac_backend -> ai_ocr : composition
ac_backend -> ai_mail : composition
ac_ratelimit -> ai_mail : serving "5/uur/IP"
ac_bewerker -> do_pdf : access "bewerkt"
ac_payload -> do_payload : access "schrijft en leest"
ac_payload -> do_sleutel : access "maakt en gebruikt"
ai_convert -> do_tmp : access "schrijft en wist"
ai_ocr -> do_tmp : access "schrijft en wist"
ss_cleanup -> do_tmp : access "wist na 30 min"
ac_scripts -> ti_nginx_static : association "verifieert live"

ai_convert -> ss_soffice : serving
ai_ocr -> ss_ocrmypdf : serving
ai_mail -> ts_smtp : serving
ts_smtp -> nd_hostinger : association "draait op"
nd_hc55 -> ss_uvicorn : assignment "host"
nd_hc55 -> ss_soffice : assignment "host"
nd_hc55 -> ss_ocrmypdf : assignment "host"
nd_hc55 -> ti_nginx_static : assignment "host"
nd_hc55 -> ss_cleanup : assignment "host"
ss_uvicorn -> ac_backend : realization
ss_slowapi -> ss_uvicorn : association "geïnstalleerd, ongebruikt"
ss_test -> ac_backend : association "test"
ti_nginx_api -> ss_uvicorn : serving "proxy"
ti_nginx_static -> ac_frontend : serving "levert"
ti_nginx_static -> ti_nginx_api : composition
nd_icthorse -> ti_nginx_static : serving "to-be"
ar_env -> ss_uvicorn : association

// ================= Klantreizen =================
Viewpoint reis_merge "Klantreis: PDF's en .docx samenvoegen" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_bestanden_kiezen bp_volgorde bp_mergen bp_downloaden"
    -description "PDF's blijven in de browser; alleen .docx gaat kort naar de server voor conversie."
}
Viewpoint reis_invullen "Klantreis: formulier invullen en ondertekenen" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_pdf_kiezen bp_invullen bp_ondertekenen bp_downloaden"
    -description "Invullen draagt de PDF over aan Ondertekenen zonder tussentijds downloaden (v0.10.0); volledig client-side."
}
Viewpoint reis_converteren "Klantreis: converteren en mailen" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_office_kiezen bp_converteren bp_mailen"
    -description "Office via LibreOffice op de server, afbeeldingen in de browser; mail via Hostinger zonder archief."
}
Viewpoint reis_ocr "Klantreis: gescande PDF doorzoekbaar maken" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_scan_kiezen bp_ocr bp_downloaden"
    -description "Tijdelijke upload, ocrmypdf nld+eng met --skip-text, direct gewist."
}
Viewpoint reis_payload "Klantreis: bestand versleuteld meesturen in een PDF" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_sleutels bp_inbedden bp_uitlezen"
    -description "Tab Geavanceerd: sleutels verlaten het apparaat alleen als de gebruiker ze downloadt."
}
Viewpoint reis_watermerk "Klantreis: watermerk zetten en teruglezen" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_pdf_kiezen bp_watermerk_zetten bp_downloaden bp_watermerk_lezen"
    -description "Onzichtbaar tekst-, beeld- of document-watermerk; lezen via metadata-payload en tekstlaag."
}
